{
  "services": [
    {
      "name": "web",
      "secrets": {
        "APP_DB_PASSWORD": "secret:app-db-password",
        "POSTGRES_PASSWORD": "secret:postgres-password",
        "REDIS_PASSWORD": "secret:redis-password",
        "INTERNAL_CA_CERT_B64": "secret:internal-ca-cert-b64",
        "OPERATIONS_CONFIG_KEY": "secret:operations-config-key"
      }
    },
    {
      "name": "postgres",
      "secrets": {
        "POSTGRES_PASSWORD": "secret:postgres-password",
        "POSTGRES_TLS_CERT_B64": "secret:postgres-tls-cert-b64",
        "POSTGRES_TLS_KEY_B64": "secret:postgres-tls-key-b64"
      }
    },
    {
      "name": "redis",
      "secrets": {
        "REDIS_PASSWORD": "secret:redis-password",
        "REDIS_TLS_CERT_B64": "secret:redis-tls-cert-b64",
        "REDIS_TLS_KEY_B64": "secret:redis-tls-key-b64"
      }
    }
  ]
}
